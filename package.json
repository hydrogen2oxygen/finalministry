{
  "name": "finalministry",
  "version": "1.0.0",
  "author": "",
  "keywords": [],
  "description": "New Electron version of Finalministry Territory Designer and Manager Application",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && electron ./dist/main.js",
    "dev": "npx concurrently \"cd ui && ng serve\" \"npx wait-on http://localhost:4200 && electron .\"",
    "build": "tsc",
    "pack": "npm run build && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hydrogen2oxygen/finalministry.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hydrogen2oxygen/finalministry/issues"
  },
  "homepage": "https://github.com/hydrogen2oxygen/finalministry#readme",
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "electron": "^35.1.4",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "build": {
    "appId": "com.finalministry.app",
    "productName": "FinalMinistry",
    "files": [
      "ui/dist/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  }
}
